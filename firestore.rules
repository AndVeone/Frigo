rules_version = '2';
// Regole di sicurezza: solo i membri di una famiglia vedono e modificano i suoi dati.
// Per entrare in una famiglia serve il suo codice invito (l'id del documento).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Profilo personale: token delle notifiche e famiglia di appartenenza
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if
        // un membro può modificare nome della famiglia e impostazioni
        (signedIn() && request.auth.uid in resource.data.members)
        // chi conosce il codice può aggiungere SOLO se stesso ai membri
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members);
      allow delete: if false;

      // Casa, spesa, catalogo della famiglia, storico movimenti e pasti
      match /{list}/{itemId} {
        allow read, write: if list in ['fridge', 'shopping', 'catalog', 'events', 'meals'] && isMember(hid);
      }
    }
  }
}
